{
  "name": "@cartwhl/mcp-server",
  "version": "0.7.0",
  "description": "Generate 3D animation with Cartwheel from MCP clients.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cartwheel-mcp": "src/index.mjs"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "docs/HOSTED.md",
    "examples/blender/*.py",
    "examples/blender/README.md",
    "examples/blender/assets/*.bvh",
    "examples/comic4/*.mjs",
    "examples/comic4/*.py",
    "examples/comic4/README.md",
    "examples/characters/*.mjs",
    "examples/characters/README.md",
    "examples/game/*.mjs",
    "examples/game/*.html",
    "examples/game/*.css",
    "examples/game/*.json",
    "examples/game/README.md",
    "examples/game/ASSETS.md",
    "examples/game/assets/*.glb",
    "examples/game/assets/*.bvh",
    "examples/game/assets/*.json",
    "examples/game/*.py",
    "examples/game/AUDIT.md",
    "examples/game/assets/MHR-LICENSE.txt"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.mjs",
    "start:hosted": "node --env-file-if-exists=.env src/hosted.mjs",
    "test": "node --test test/*.test.mjs",
    "check:package": "npm pack --dry-run",
    "example:game": "node examples/game/serve.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cartwhl/cartwheel-mcp.git"
  },
  "homepage": "https://github.com/Cartwhl/cartwheel-mcp#readme",
  "bugs": {
    "url": "https://github.com/Cartwhl/cartwheel-mcp/issues"
  },
  "keywords": [
    "mcp",
    "cartwheel",
    "animation",
    "blender",
    "motion-capture"
  ],
  "dependencies": {
    "@aws-sdk/credential-provider-node": "^3.972.86",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@smithy/hash-node": "^4.5.2",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "ajv": "^8.20.0",
    "jose": "^6.2.12",
    "raw-body": "^3.0.0",
    "three": "0.185.1"
  }
}
