  {
    "name": "generate_motion",
    "method": "POST",
    "path": "/motion/fromText",
    "description": "Generates motion animation based on text prompts.\nReturns a batch ID for tracking the generation progress. Consumes generation credits. Submit once, then use get_batch and list_batch_motions to poll; do not resubmit to check progress.",
    "parameters": [],
    "inputSchema": {
      "type": "object",
      "required": [
        "exportSettings",
        "prompts",
        "requestedModel"
      ],
      "properties": {
        "batchName": {
          "type": "string",
          "maxLength": 100,
          "description": "An optional name to be associated with the batch. Will be used to identify the batch in the Cartwheel UI and email notifications.",
          "example": "Project X"
        },
        "exportSettings": {
          "allOf": [
            {
              "allOf": [
                {
                  "type": "object",
                  "properties": {
                    "exportType": {
                      "type": "string",
                      "enum": [
                        "bvh",
                        "fbx-blender",
                        "fbx-maya",
                        "fbx-unreal",
                        "fbx-roblox",
                        "glb",
                        "ma",
                        "mb",
                        "qpos"
                      ],
                      "description": "The format of the export to generate. `qpos` (MuJoCo joint vector) is available only for MJCF-origin robot characters.",
                      "example": "fbx-blender"
                    },
                    "faceExpression": {
                      "type": "string",
                      "enum": [
                        "Default",
                        "Neutral",
                        "Angry",
                        "Annoyed",
                        "Bored",
                        "Confusion",
                        "DelightedGrin",
                        "Delighted",
                        "Excited",
                        "Goof",
                        "HappyLookLeft",
                        "HappyLookRight",
                        "Love",
                        "Nervous",
                        "Pain",
                        "Pleased",
                        "Puzzled",
                        "Rage",
                        "RollLookLeft",
                        "RollLookRight",
                        "Sad",
                        "SadEyesClosed",
                        "SadLookLeft",
                        "SadLookRight",
                        "Squeeze",
                        "Stretch",
                        "Stunned",
                        "Surprise",
                        "Suspicious",
                        "ThinkingLookLeft",
                        "ThinkingLookRight",
                        "Wink"
                      ],
                      "description": "The face expression to apply on the character",
                      "example": "Default"
                    },
                    "forward": {
                      "type": "string",
                      "enum": [
                        "Z",
                        "Y",
                        "X",
                        "-Z",
                        "-Y",
                        "-X"
                      ],
                      "description": "The axis to use for the forward orientation of the motion",
                      "example": "Z"
                    },
                    "frameRate": {
                      "type": "number",
                      "enum": [
                        2,
                        12,
                        23.976,
                        24,
                        25,
                        29.97,
                        30,
                        48,
                        50,
                        59.94,
                        60,
                        90,
                        100,
                        120,
                        144,
                        240
                      ],
                      "description": "Export frame rate. Keep the same frame rate for every actor and use the source rate for synchronized comparison.",
                      "example": 24
                    },
                    "frameStepSize": {
                      "type": "number",
                      "description": "The frame step size of the motion generation",
                      "example": 1,
                      "minimum": 1
                    },
                    "handPose": {
                      "type": "string",
                      "enum": [
                        "default",
                        "claw",
                        "curled",
                        "fist",
                        "fist_clenched",
                        "fist_relaxed",
                        "gripping",
                        "love_you",
                        "open_loose",
                        "open_tight",
                        "peace",
                        "pointing",
                        "pointing_cool",
                        "relaxed",
                        "rock",
                        "splay",
                        "thumbs_up"
                      ],
                      "description": "The hand pose to apply on the character. Not applicable for motions from video.",
                      "example": "relaxed"
                    },
                    "ikFeet": {
                      "type": "boolean",
                      "description": "Whether to use inverse kinematics for the feet. Applicable only for MAYA exports.",
                      "example": true
                    },
                    "ikHands": {
                      "type": "boolean",
                      "description": "Whether to use inverse kinematics for the hands. Applicable only for MAYA exports.",
                      "example": false
                    },
                    "includeMesh": {
                      "type": "boolean",
                      "description": "Whether to include the mesh in the motion generation",
                      "example": true
                    },
                    "keyframeCleaning": {
                      "type": "string",
                      "enum": [
                        "none",
                        "reduce",
                        "simplify"
                      ],
                      "description": "The keyframe cleaning method to use for the motion generation",
                      "example": "none"
                    },
                    "moveInPlace": {
                      "type": "boolean",
                      "description": "Whether to move the character in place",
                      "example": false
                    },
                    "rotationOffsets": {
                      "type": "object",
                      "description": "The rotation offsets to use for the motion generation",
                      "properties": {
                        "head": {
                          "type": "array",
                          "description": "The rotation offset for the head",
                          "items": {
                            "type": "number"
                          },
                          "example": [
                            0,
                            0,
                            0
                          ]
                        },
                        "left_collar": {
                          "type": "array",
                          "description": "The rotation offset for the left collar",
                          "items": {
                            "type": "number"
                          },
                          "example": [
                            0,
                            0,
                            0
                          ]
                        },
                        "right_collar": {
                          "type": "array",
                          "description": "The rotation offset for the right collar",
                          "items": {
                            "type": "number"
                          },
                          "example": [
                            0,
                            0,
                            0
                          ]
                        },
                        "left_shoulder": {
                          "type": "array",
                          "description": "The rotation offset for the left shoulder",
                          "items": {
                            "type": "number"
                          },
                          "example": [
                            0,
                            0,
                            0
                          ]
                        },
                        "right_shoulder": {
                          "type": "array",
                          "description": "The rotation offset for the right shoulder",
                          "items": {
                            "type": "number"
                          },
                          "example": [
                            0,
                            0,
                            0
                          ]
                        },
                        "left_hip": {
                          "type": "array",
                          "description": "The rotation offset for the left hip",
                          "items": {
                            "type": "number"
                          },
                          "example": [
                            0,
                            0,
                            0
                          ]
                        },
                        "right_hip": {
                          "type": "array",
                          "description": "The rotation offset for the right hip",
                          "items": {
                            "type": "number"
                          },
                          "example": [
                            0,
                            0,
                            0
                          ]
                        },
                        "neck": {
                          "type": "array",
                          "description": "The rotation offset for the neck",
                          "items": {
                            "type": "number"
                          },
                          "example": [
                            0,
                            0,
                            0
                          ]
                        }
                      },
                      "example": {
                        "head": [
                          0,
                          0,
                          0
                        ],
                        "left_ankle": [
                          0,
                          0,
                          0
                        ],
                        "right_ankle": [
                          0,
                          0,
                          0
                        ],
                        "left_collar": [
                          0,
                          0,
                          0
                        ],
                        "right_collar": [
                          0,
                          0,
                          0
                        ],
                        "left_hip": [
                          0,
                          0,
                          0
                        ],
                        "right_hip": [
                          0,
                          0,
                          0
                        ],
                        "left_shoulder": [
                          0,
                          0,
                          0
                        ],
                        "right_shoulder": [
                          0,
                          0,
                          0
                        ],
                        "neck": [
                          0,
                          0,
                          0
                        ]
                      }
                    },
                    "skinHex": {
                      "type": "string",
                      "description": "The skin hex color to use for the character",
                      "example": "#BF916D"
                    },
                    "up": {
                      "type": "string",
                      "enum": [
                        "Z",
                        "Y",
                        "X",
                        "-Z",
                        "-Y",
                        "-X"
                      ],
                      "description": "The axis to use for the up orientation of the motion",
                      "example": "Y"
                    }
                  }
                }
              ],
              "required": [
                "exportType",
                "forward",
                "frameRate",
                "frameStepSize",
                "up"
              ]
            },
            {
              "type": "object",
              "required": [
                "characterID"
              ],
              "properties": {
                "characterID": {
                  "type": "string",
                  "description": "The ID of the character to export the motion on.",
                  "example": "char-upload-Axel"
                }
              }
            }
          ],
          "description": "The export settings for the motion generation"
        },
        "loop": {
          "type": "boolean",
          "description": "If true, the motion generation will be looped on a seamless repeat. Applied to all motions in a batch. Defaults to false.",
          "example": false
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The prompts describing the desired motions",
          "example": [
            "A person waving hello",
            "A person walking forward",
            "A person jumping"
          ]
        },
        "requestedModel": {
          "type": "string",
          "description": "The model to use for the motion generation",
          "enum": [
            "scoot",
            "swing"
          ],
          "example": "swing"
        },
        "swingProperties": {
          "type": "object",
          "description": "Optional parameters specific to the 'swing' model. Ignored if requestedModel is not 'swing'.",
          "properties": {
            "cfgScale": {
              "type": "number",
              "format": "float",
              "description": "Classifier free guidance value (1-9). Higher values produce motions that more closely match the prompt. Defaults to 7.5.",
              "minimum": 1,
              "maximum": 9,
              "example": 7.5
            },
            "duration": {
              "type": "number",
              "format": "float",
              "description": "Duration of the generated motion in seconds (3-8). Defaults to 5.",
              "minimum": 3,
              "maximum": 8,
              "example": 5
            }
          }
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "get_motion",
    "method": "GET",
    "path": "/motion/{motionID}",
    "description": "Retrieve primary motion status/downloads or apply one actor’s body to another accessible character. For multi-person Comic retargeting provide characterID and its zero-based bodyIndex. Use list_batch_motions for the complete ordered body, facial, identity and source-camera output arrays.",
    "parameters": [
      {
        "name": "motionID",
        "location": "path"
      },
      {
        "name": "characterID",
        "location": "query"
      },
      {
        "name": "downloadType",
        "location": "query"
      },
      {
        "name": "fps",
        "location": "query"
      },
      {
        "name": "bodyIndex",
        "location": "query"
      }
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "motionID": {
          "type": "string",
          "example": "mogen-job-12345",
          "description": "The motion job ID to retrieve"
        },
        "characterID": {
          "type": "string",
          "description": "Optional character ID to apply while retrieving this motion. Requires access to the character."
        },
        "downloadType": {
          "type": "string",
          "description": "Optional download format to return. Requires characterID. Defaults to bvh.\nUse cwms for MotionSync CWMS text. Use fbx only when the character asset is FBX.\nUse gltf for a GLB/GLTF download when the character asset is GLTF or GLB.\n",
          "enum": [
            "bvh",
            "cwms",
            "fbx",
            "gltf"
          ]
        },
        "fps": {
          "type": "number",
          "enum": [
            2,
            12,
            23.976,
            24,
            25,
            29.97,
            30,
            48,
            50,
            59.94,
            60,
            90,
            100,
            120,
            144,
            240
          ],
          "description": "Optional output frame rate for BVH output. Defaults to 60.",
          "example": 24
        },
        "bodyIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based person index for multi-person Comic body retargeting. Defaults to 0. An index above 0 requires characterID; it selects that actor before retargeting."
        }
      },
      "required": [
        "motionID"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "bodyIndex"
            ],
            "properties": {
              "bodyIndex": {
                "minimum": 1
              }
            }
          },
          "then": {
            "required": [
              "characterID"
            ]
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "search_motions",
    "method": "POST",
    "path": "/motion/search",
    "description": "Searches the motion library with optional filtering by category, subcategory, tags, and search term.\nReturns paginated results with motion items and category aggregation information.",
    "parameters": [],
    "inputSchema": {
      "type": "object",
      "required": [
        "pageSize"
      ],
      "properties": {
        "category": {
          "type": "string",
          "description": "Filter results by category",
          "example": "locomotion"
        },
        "pageSize": {
          "type": "integer",
          "description": "Number of results to return per page",
          "minimum": 1,
          "maximum": 100,
          "example": 20
        },
        "searchAfter": {
          "type": "array",
          "description": "A pagination token from a previous search response (lastSort value). Use this to fetch subsequent pages.",
          "items": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "example": [
            22.458934,
            "motion-12345"
          ]
        },
        "searchTerm": {
          "type": "string",
          "description": "Text search query to find matching motions",
          "example": "walking forward"
        },
        "subcategory": {
          "type": "string",
          "description": "Filter results by subcategory (requires category to be set)",
          "example": "walking"
        },
        "tags": {
          "type": "array",
          "description": "Filter results by tags",
          "items": {
            "type": "string"
          },
          "example": [
            "fast",
            "slow"
          ]
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "list_motions",
    "method": "GET",
    "path": "/motions",
    "description": "Retrieves a paginated list of recent motion generations created for the\nauthenticated service account. Results are sorted by creation time,\nnewest first by default.",
    "parameters": [
      {
        "name": "limit",
        "location": "query"
      },
      {
        "name": "nextToken",
        "location": "query"
      },
      {
        "name": "sortAscending",
        "location": "query"
      }
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25,
          "example": 25,
          "description": "Maximum number of motions to return"
        },
        "nextToken": {
          "type": "string",
          "example": "eyJsYXN0S2V5IjoibW9nZW4tam9iLTAxSlNaOVg3MFY3RkQ2RlhaNlRUWTVFRTFLIn0=",
          "description": "Pagination token from a previous response"
        },
        "sortAscending": {
          "type": "boolean",
          "default": false,
          "example": false,
          "description": "Sort results in ascending order by creation time"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "list_batch_motions",
    "method": "GET",
    "path": "/motions/{batchID}",
    "description": "Retrieves a paginated list of motion generations for a specific batch.\nReturns motion generation records with presigned URLs for BVH files and preview videos. Comic 4 items include ordered per-person body, face, identity and export arrays plus the captured camera when available. Preserve null slots. get_motion does not replace this complete batch listing.",
    "parameters": [
      {
        "name": "batchID",
        "location": "path"
      },
      {
        "name": "limit",
        "location": "query"
      },
      {
        "name": "nextToken",
        "location": "query"
      }
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "batchID": {
          "type": "string",
          "example": "batch-XXXXX-12345",
          "description": "The batch identifier to retrieve motions for"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of results to return per page"
        },
        "nextToken": {
          "type": "string",
          "description": "Pagination token from a previous response to fetch the next page"
        }
      },
      "required": [
        "batchID",
        "limit"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "get_batch",
    "method": "GET",
    "path": "/batch/{batchID}",
    "description": "Retrieves batch details including status, progress, and export settings.\nUse this endpoint to check the status of a batch job created via /motion/fromVideo or /motion/fromText.",
    "parameters": [
      {
        "name": "batchID",
        "location": "path"
      }
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "batchID": {
          "type": "string",
          "example": "batch-XXXXX-12345",
          "description": "The batch ID to retrieve"
        }
      },
      "required": [
        "batchID"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "create_media_upload",
    "method": "POST",
    "path": "/media/upload",
    "description": "Prepare signed upload URLs for video references. This creates media slots; it does not upload the file bytes. Use the client's authorized file tools to PUT each selected local video to its returned mediaUploadURL without an API key header. Upload before calling generate_motion_from_video. Video references must be at most 30 seconds and smaller than 250 MB. Keep signed URLs private.",
    "parameters": [],
    "inputSchema": {
      "type": "object",
      "properties": {
        "media": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "extension": {
                "type": "string",
                "enum": [
                  "mp4",
                  "mov",
                  "webm",
                  "avi",
                  "mkv"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 30
              },
              "resolution": {
                "type": "string",
                "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"
              }
            },
            "required": [
              "extension",
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "media"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "get_media",
    "method": "GET",
    "path": "/media/{mediaID}",
