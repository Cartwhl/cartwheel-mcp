    "method": "POST",
    "path": "/motion/fromVideo",
    "description": "Capture editable body, hand and optional face performance from uploaded videos using Comic 4. Supports 1–4 people per video. Requires uploaded media IDs and complete export settings. Consumes credits: submit once, then poll get_batch and list_batch_motions. Preserve every actor's ordered exports, MHR face/body assets and camera from list_batch_motions. Use get_motion with characterID and bodyIndex for a particular actor's body retarget. Keep moveInPlace false to preserve interactions and shared world placement.",
    "parameters": [],
    "inputSchema": {
      "type": "object",
      "properties": {
        "mediaIDs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "comicModel": {
          "type": "string",
          "enum": [
            "comic4"
          ],
          "description": "Explicitly select the Comic 4 performance capture pipeline."
        },
        "numPeople": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 1
        },
        "facialCapture": {
          "type": "boolean",
          "default": false
        },
        "batchName": {
          "type": "string",
