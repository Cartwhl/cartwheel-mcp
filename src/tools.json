        "location": "query"
      },
      {
        "name": "nextToken",
        "location": "query"
      },
      {
        "name": "sortAscending",
        "location": "query"
      }
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "example": 25,
          "description": "Maximum number of scenes to return"
        },
        "nextToken": {
          "type": "string",
          "example": "eyJwayI6InNjZW5lLS4uLiJ9",
          "description": "Pagination token from a previous response"
        },
        "sortAscending": {
          "type": "boolean",
          "example": false,
          "description": "Sort results in ascending order by creation time"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "get_scene",
    "method": "GET",
    "path": "/scenes/{sceneID}",
    "description": "Retrieves a scene accessible to the authenticated service account.",
    "parameters": [
      {
        "name": "sceneID",
        "location": "path"
      }
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "sceneID": {
          "type": "string",
          "example": "scene-12345",
          "description": "The scene ID"
        }
      },
      "required": [
        "sceneID"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
