[
  {
    "name": "list_characters",
    "method": "GET",
    "path": "/characters",
    "description": "Retrieves a list of characters available to the authenticated service account.\nIncludes presigned URLs for character assets.",
    "parameters": [
      {
        "name": "limit",
        "location": "query"
      },
      {
        "name": "nextToken",
        "location": "query"
      },
      {
        "name": "sortAscending",
        "location": "query"
      }
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "example": 10,
          "description": "Maximum number of characters to return"
        },
        "nextToken": {
          "type": "string",
          "example": "eyJwayI6InVzZXItLi4uIn0=",
          "description": "Pagination token from a previous response"
        },
        "sortAscending": {
          "type": "boolean",
          "example": false,
          "description": "Sort results in ascending order by creation time"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "get_character",
    "method": "GET",
    "path": "/characters/{characterID}",
    "description": "Retrieves a character's details, `uploadStatus`, and presigned download\nURLs. Poll this after submitting an upload until `uploadStatus` is\n`COMPLETE` (or `FAILED`); while processing, the response includes an\n`estimatedSecondsWaitTime`. Once complete, it returns download URLs for\nthe rigged character (`characterFileURL`, `baseFbxURL`, `baseGlbURL`),\nits config (`configURL`), and thumbnail (`thumbnailURL`).",
    "parameters": [
      {
        "name": "characterID",
        "location": "path"
      }
    ],
    "inputSchema": {
      "type": "object",
      "properties": {
        "characterID": {
          "type": "string",
          "example": "char-upload-12345",
          "description": "The character ID to retrieve"
        }
      },
      "required": [
        "characterID"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
