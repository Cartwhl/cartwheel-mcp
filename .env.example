# Local stdio/motion tools only. Not used by the hosted service.
CARTWHEEL_API_KEY=replace-with-your-production-project-key

# Hosted OAuth profile MVP: npm run start:hosted (see docs/HOSTED.md).
# Nonsecret configuration. Use the same Consumer Stytch project as the frontend.
MCP_PUBLIC_URL=https://your-mcp-host.example/mcp
STYTCH_ISSUER=https://your-project.customers.stytch.com
STYTCH_PROJECT_ID=project-test-replace-with-project-id
STYTCH_CLIENT_ID=connected-app-test-replace-with-pre-registered-client-id
# Optional second fixed client. Leave unset until Claude is manually registered.
# MCP_CLAUDE_CLIENT_ID=connected-app-test-replace-with-registered-claude-id
HOST=127.0.0.1
PORT=3001
# Optional comma-separated browser origins, exact matches; never '*'.
# MCP_ALLOWED_ORIGINS=http://localhost:6274

# Hosted motion is opt-in; profile-only remains the default.
MCP_MOTION_ENABLED=false
# Enable only after backend/consent deployment and staging verification.
# MCP_USER_API_ENVIRONMENT=staging
# MCP_USER_API_URL=https://user-staging.api.getcartwheel.com/mcp/credential
# Explicit region of the deployed user-api HTTP API (not inferred from the host).
# MCP_USER_API_REGION=us-east-1
# Local only: a profile that assumes user-api's configured MCP_CALLER_ROLE_ARN.
# AWS_PROFILE=cartwheel-mcp-staging
# Future AWS Lambda hosting: use its execution role via the default credential chain.
# That role must match MCP_CALLER_ROLE_ARN; no static keys. Hosting adapter is pending.
# Production requires environment=production, matching live Stytch IDs, and:
# MCP_USER_API_URL=https://user.api.getcartwheel.com/mcp/credential
